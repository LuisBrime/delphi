{
  "name": "delphi",
  "version": "0.0.1",
  "description": "Discord Bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuisBrime/delphi"
  },
  "author": "Luis Brime",
  "license": "MIT",
  "scripts": {
    "start": "yarn serve",
    "build": "yarn build-ts",
    "serve": "node delphi/dist/server.js",
    "watch-node": "nodemon delphi/dist/server.js",
    "test": "yarn lint && jest --forceExit --coverage --verbose",
    "build-ts": "tsc",
    "watch-ts": "tsc -w",
    "lint": "yarn eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "discord.js": "^12.3.1"
  },
  "devDependencies": {
    "@types/jest": "^26.0.13",
    "@types/node": "^14.6.4",
    "@typescript-eslint/eslint-plugin": "^4.0.1",
    "@typescript-eslint/parser": "^4.0.1",
    "eslint": "^7.8.1",
    "istanbul-api": "^3.0.0",
    "istanbul-reports": "^3.0.2",
    "jest": "^26.4.2",
    "ts-jest": "^26.3.0",
    "ts-mockito": "^2.6.1",
    "ts-node": "^9.0.0",
    "typescript": "^4.0.2"
  }
}
